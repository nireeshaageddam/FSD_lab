<!DOCTYPE html>
<html>

<head>
    <title>Week 7 - Server Side Rendering</title>
</head>

<body>

    <h1>Server-Side Rendering</h1>

    <h2>Welcome, <%= name %>!</h2>

    <p>Course: <%= course %></p>

    <hr>

    <h2>Student Form</h2>

    <form action="/submit" method="POST">

        <label>Name:</label>
        <input type="text" name="name">

        <br><br>

        <label>Email:</label>
        <input type="email" name="email">

        <br><br>

        <button type="submit">Submit</button>

    </form>

</body>

</html>